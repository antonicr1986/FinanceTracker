# Copia este fichero como terraform.tfvars (ignorado en git) y rellenalo.
# Los valores por defecto de variables.tf ya sirven; aqui solo lo que cambies.
#
# Lo normal es no usar este fichero: .\up.ps1 lee de Azure la imagen y la clave
# JWT (Key Vault) y genera la contrasena de la base de datos.
#
# La contrasena de la base de datos y la clave JWT NO van aqui (son efimeras):
# se pasan como variables de entorno (TF_VAR_db_password, TF_VAR_jwt_key).
# La imagen (container_image) tampoco: no tiene valor por defecto y solo acepta
# una version sha-<commit>, nunca :latest.

# region            = "eu-west-1"
# db_instance_class = "db.t3.micro"
